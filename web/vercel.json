{
  "headers": [
    { "source": "/(.*)\\.(glb|hdr|ktx2|png|jpg|webp)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=604800" } ] },
    { "source": "/(.*)\\.js", "headers": [ { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=604800" } ] },
    { "source": "/(.*)\\.html", "headers": [ { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" } ] }
  ]
}
